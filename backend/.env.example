# Copia in backend/.env e compila i valori. Non committare mai il file .env.

# --- Generale ---
ENVIRONMENT=development
LOG_LEVEL=INFO
FRONTEND_URL=http://localhost:3000

# --- Supabase (Project Settings > API) ---
SUPABASE_URL=https://xxxxxxxx.supabase.co
# Chiave service_role: SOLO lato backend, bypassa la RLS.
SUPABASE_SERVICE_ROLE_KEY=

# --- Messaging: "meta" (WhatsApp Cloud API) oppure "twilio" (Sandbox) ---
MESSAGING_PROVIDER=meta

# Meta WhatsApp Cloud API
META_VERIFY_TOKEN=scegli-una-stringa-casuale
META_APP_SECRET=
META_ACCESS_TOKEN=
META_GRAPH_API_VERSION=v21.0

# Twilio WhatsApp Sandbox
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# --- LLM: "groq" oppure "gemini" ---
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# --- Google Calendar OAuth (Google Cloud Console > Credentials) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/oauth/google/callback

# --- Sicurezza ---
# Chiave Fernet per cifrare i refresh token Google nel DB. Generala con:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=
