# Copia in backend/.env e compila i valori. Non committare mai il file .env.

# --- Generale ---
ENVIRONMENT=development
LOG_LEVEL=INFO
FRONTEND_URL=http://localhost:3000

# --- Supabase (Project Settings > API) ---
SUPABASE_URL=https://xxxxxxxx.supabase.co
# Chiave service_role: SOLO lato backend, bypassa la RLS.
SUPABASE_SERVICE_ROLE_KEY=

# URL pubblico del backend (Render o tunnel ngrok/cloudflared in locale).
# Necessario per verificare la firma dei webhook Twilio.
PUBLIC_BASE_URL=

# --- Messaging ---
# Il provider è scelto per ogni attività (colonna tenants.messaging_provider).
# Webhook: GET/POST {PUBLIC_BASE_URL}/webhooks/meta  |  POST {PUBLIC_BASE_URL}/webhooks/twilio
# In development, se il segreto è vuoto la verifica firma viene saltata (con warning).

# Meta WhatsApp Cloud API
META_VERIFY_TOKEN=scegli-una-stringa-casuale
META_APP_SECRET=
META_ACCESS_TOKEN=
META_GRAPH_API_VERSION=v21.0

# Twilio WhatsApp Sandbox
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# --- LLM: "groq" oppure "gemini" ---
# Il provider non primario, se ha una chiave, viene usato come fallback automatico.
LLM_PROVIDER=groq
LLM_TIMEOUT_SECONDS=15
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# Solo per modelli a ragionamento (gpt-oss: low/medium/high). Vuoto = non inviato.
GROQ_REASONING_EFFORT=low
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Gemini 3: minimal/low/medium/high (minimal = risposta più rapida). Vuoto = default.
GEMINI_THINKING_LEVEL=minimal

# --- Google Calendar OAuth (Google Cloud Console > API e servizi > Credenziali) ---
# Client OAuth di tipo "Applicazione web". Il redirect URI deve coincidere ESATTAMENTE
# con uno di quelli autorizzati nella console (in produzione: https://<backend>/oauth/google/callback).
# Dopo il consenso l'utente torna su {FRONTEND_URL}/dashboard/settings?google=connected|error.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/oauth/google/callback

# --- Sicurezza ---
# Chiave Fernet per cifrare i refresh token Google nel DB e firmare lo "state" OAuth.
# Usa la STESSA chiave in tutti gli ambienti che condividono il DB: se cambia, i
# calendari già collegati vanno ricollegati. Generala con:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=
